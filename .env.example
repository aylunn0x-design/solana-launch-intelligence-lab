# Copy to .env and fill in. NEVER commit a real .env.
# This file contains no secrets; it documents the variables that exist.

# --- Database (docker compose) ---
POSTGRES_USER=solana_lab
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=solana_lab
POSTGRES_PORT=5432

# --- Backend ---
# Local (no infrastructure): sqlite:///./solana_lab.db
# Postgres: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./solana_lab.db
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Provider rate limits (requests per minute) ---
# Conservative on purpose: the documented free-tier limits could not be
# verified, and HTTP 429 was observed after a small burst. The client also
# backs off adaptively, so these are a floor rather than a correctness
# dependency. See DATA_SOURCES.md.
GECKOTERMINAL_RATE_LIMIT_PER_MIN=25
DEXSCREENER_RATE_LIMIT_PER_MIN=50
SOLANA_RPC_RATE_LIMIT_PER_MIN=20
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=4

# --- Holder concentration ---
# Off by default: the public RPC rate-limits getTokenLargestAccounts and caps
# it at 20 accounts. Enabling it meaningfully needs a dedicated RPC provider,
# whose URL (which may embed an API key) belongs in .env, never in source.
ENABLE_HOLDER_COLLECTION=false
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Research defaults ---
DEFAULT_INACTIVITY_THRESHOLD_HOURS=24
MIN_CANDLES_FOR_ANALYSIS=6

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
